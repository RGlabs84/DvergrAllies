<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>DvergrAllies</AssemblyName>
    <Description>A Valheim mod that allows taming and crossbreeding Dvergrs.</Description>
    <Version>1.0.14</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <!-- CS0436: the assembly publicizer's own IgnoresAccessChecksToAttribute (a source file in its content files, compiled
         into this DLL) meets the public copy inside MonoMod.Utils, which BepInEx.Core brings in. The compiler picks ours and
         warns; the two are the same attribute and the warning is only in the generated AssemblyInfo.cs. Same suppression as
         Runic and BlightedHeart. It is scoped to this one code, so any other warning still shows. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <!-- Every package ships the PDB that matches its DLL (owner, 2026-11-20): portable and deterministic, with the builder's folders
         mapped to neutral names and SourceLink off (it embeds the home path and the git commit). Without PathMap the DLL alone leaks
         the path of its own PDB. libs-Tools/pdb_match.py checks the pair before a fold. -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=DvergrAllies,$(NuGetPackageRoot)=nuget/</PathMap>
    <DebugType>portable</DebugType>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <!-- tools/ holds standalone harnesses with their own csproj (and their own obj/ output). Without this
       the SDK's default **/*.cs glob sucks their sources AND their generated AssemblyInfo.cs into this
       assembly, which fails with duplicate-attribute CS0579 the moment a harness has been built once. -->
  <ItemGroup>
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Newtonsoft.Json is NOT provided by Valheim or BepInExPack. PackageReference copies it to the
         build output next to DvergrAllies.dll by default so the BarrkBOT JSON export doesn't throw
         FileNotFoundException the moment it JITs - see WubarrksEye.csproj for the same failure mode. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.28" IncludeAssets="compile" />
    <PackageReference Include="JotunnLib" Version="[2.30.0]" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" />
  </ItemGroup>

  <!-- ALL reference assemblies come from the SHARED c:\WubarrkCODING\ValheimMods\libs-Tools folder, never from a per-project
       libs\ copy. That is the standing rule across every mod in this solution root. -->
  <ItemGroup>
    <Reference Include="assembly_valheim" Publicize="true">
      <HintPath>..\libs-Tools\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils" Publicize="true">
      <HintPath>..\libs-Tools\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils" Publicize="true">
      <HintPath>..\libs-Tools\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="gui_framework">
      <HintPath>..\libs-Tools\gui_framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="steamworks.net">
      <HintPath>..\libs-Tools\steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>..\libs-Tools\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>


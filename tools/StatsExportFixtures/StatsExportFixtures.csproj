<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>DvergrAllies.StatsExportFixtures</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Links the mod's actual JSON-shaping code (no Unity/Valheim dependency) so these fixtures are
       generated by the exact same code DvergrStatsExporter calls in-game, not a reimplementation that
       could drift from it. -->
  <ItemGroup>
    <Compile Include="..\..\DvergrStatsSchema.cs" Link="DvergrStatsSchema.cs" />
    <Compile Include="..\..\DvergrLifetimeStats.cs" Link="DvergrLifetimeStats.cs" />
  </ItemGroup>
</Project>
